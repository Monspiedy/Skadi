# Local configuration and secrets
config/database.local.php
.env
.env.*
!.env.example

# User uploads are local runtime data, not source code
uploads/avatars/*
uploads/covers/*
uploads/guides/*
uploads/screenshots/*
storage/chat-attachments/*
!uploads/avatars/.gitkeep
!uploads/covers/.gitkeep
!uploads/guides/.gitkeep
!uploads/screenshots/.gitkeep
!storage/chat-attachments/.gitkeep
!storage/chat-attachments/.htaccess

# Logs, caches and temporary files
storage/logs/*
storage/cache/*
!storage/logs/.gitkeep
!storage/cache/.gitkeep
*.log
*.tmp

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# Dependencies, if introduced later
vendor/
node_modules/
